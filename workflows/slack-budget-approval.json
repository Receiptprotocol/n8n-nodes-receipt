{
  "name": "Get with Receipt — Slack budget approval",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "operation": "getOutcome",
        "task": "Research Receipt Protocol universal agent commerce",
        "inputType": "json",
        "inputJson": "{\"query\":\"Receipt Protocol universal agent commerce\"}",
        "maxSpend": 1,
        "validateAs": "delivered",
        "projectId": "n8n-slack-approval",
        "idempotencyKey": "={{$execution.id}}:quote",
        "dryRun": true
      },
      "id": "quote",
      "name": "Quote with Receipt",
      "type": "n8n-nodes-receipt.getWithReceipt",
      "typeVersion": 1,
      "position": [240, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "within-policy",
              "leftValue": "={{Number($json.quotedMaximum.amount)}}",
              "rightValue": 0.1,
              "operator": { "type": "number", "operation": "lte" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "within-policy",
      "name": "Within $0.10 policy?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "operation": "sendAndWait",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "CHOOSE_A_CHANNEL",
          "mode": "list"
        },
        "message": "=Approve Receipt purchase from {{$json.seller.name}} for up to {{$json.quotedMaximum.amount}} {{$json.quotedMaximum.currency}}?",
        "responseType": "approval",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "approveLabel": "Approve purchase",
            "disapproveLabel": "Reject"
          }
        },
        "options": {}
      },
      "id": "slack-approval",
      "name": "Request Slack approval",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [720, 160]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "approved",
              "leftValue": "={{$json.data.approved}}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "approved",
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [960, 160]
    },
    {
      "parameters": {
        "operation": "getOutcome",
        "task": "Research Receipt Protocol universal agent commerce",
        "inputType": "json",
        "inputJson": "{\"query\":\"Receipt Protocol universal agent commerce\"}",
        "maxSpend": 1,
        "validateAs": "delivered",
        "projectId": "n8n-slack-approval",
        "idempotencyKey": "={{$execution.id}}:purchase",
        "dryRun": false
      },
      "id": "purchase",
      "name": "Purchase with Receipt",
      "type": "n8n-nodes-receipt.getWithReceipt",
      "typeVersion": 1,
      "position": [1200, 0]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [[{ "node": "Quote with Receipt", "type": "main", "index": 0 }]]
    },
    "Quote with Receipt": {
      "main": [[{ "node": "Within $0.10 policy?", "type": "main", "index": 0 }]]
    },
    "Within $0.10 policy?": {
      "main": [
        [{ "node": "Purchase with Receipt", "type": "main", "index": 0 }],
        [{ "node": "Request Slack approval", "type": "main", "index": 0 }]
      ]
    },
    "Request Slack approval": {
      "main": [[{ "node": "Approved?", "type": "main", "index": 0 }]]
    },
    "Approved?": {
      "main": [[{ "node": "Purchase with Receipt", "type": "main", "index": 0 }], []]
    }
  },
  "active": false,
  "settings": {},
  "versionId": "f9ee0574-a508-4688-901f-74058925e070"
}
