{
  "name": "n8n-nodes-receipt",
  "version": "0.1.0",
  "description": "Acquire an outcome through Receipt, discover eligible supply, and verify Open Receipts locally.",
  "license": "MIT",
  "homepage": "https://receiptprotocol.com/docs/get",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "receipt",
    "agent-commerce"
  ],
  "author": {
    "name": "Receipt Protocol",
    "email": "hello@receiptprotocol.com",
    "url": "https://receiptprotocol.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Receiptprotocol/n8n-nodes-receipt.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "test": "bun test ./tests",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist",
    "README.md",
    "workflows"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/ReceiptApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/GetWithReceipt/GetWithReceipt.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.39.3",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=20.15"
  }
}
